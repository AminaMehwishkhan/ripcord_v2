# AssemblyAI — required for real (non-mock) mode
# Get a key at https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# Optional: only needed if you enable LLM-phrased clarification questions.
# Ripcord never uses an LLM to make the risk/safety decision — deterministic only.
LLM_API_KEY=

# Optional: only needed if you wire up Supabase for session/event logging.
SUPABASE_URL=
SUPABASE_KEY=

# When true, the backend simulates ASR events instead of calling AssemblyAI.
# Lets you build/demo the UI without consuming API credits.
# The hackathon submission / real demo MUST run with MOCK_MODE=false.
MOCK_MODE=true

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AssemblyAI speech model for streaming (see docs/architecture.md)
ASSEMBLYAI_SPEECH_MODEL=universal-streaming-english

# Optional: override the clarify threshold (a probability between 0 and 1).
# Leave empty to use the operating point saved with the trained risk model.
RISK_CLARIFY_THRESHOLD=
